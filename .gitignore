# ─── Node / npm ────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Environment / Secrets (NEVER commit real .env files) ──────────────────
.env
backend/.env
intelligence-engine/.env
*.env.local
*.env.*.local

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
.env/
intelligence-engine/venv/
intelligence-engine/.venv/
frontend/.venv/
*.egg-info/
dist/
build/
*.egg

# ─── Angular build output ──────────────────────────────────────────────────
frontend/dist/
frontend/.angular/cache/

# ─── Uploaded PDF files ────────────────────────────────────────────────────
backend/uploads/
*.pdf

# ─── ML Models & large data (use Git LFS or cloud storage instead) ─────────
intelligence-engine/saved_models/*.pkl
intelligence-engine/saved_models/*.joblib
intelligence-engine/saved_models/*.h5
intelligence-engine/saved_models/*.pt
intelligence-engine/data/*.csv
intelligence-engine/data/*.json
intelligence-engine/notebooks/*.ipynb

# ─── Kaggle credentials ────────────────────────────────────────────────────
kaggle.json
.kaggle/

# ─── OS junk ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ──────────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Logs ─────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Test artifacts ───────────────────────────────────────────────────────
coverage/
.nyc_output/
